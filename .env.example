# =============================================================================
# KIMS WhatsApp acknowledgement service - configuration template
# Copy to .env and fill in. .env is gitignored and never baked into the image.
# Check it with:  python -m app.config
# =============================================================================

# --- Database (MariaDB 10.5) -------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- ACL WhatsApp (BSP) ------------------------------------------------------
ACL_AUTH_URL=https://auth.aclwhatsapp.com/realms/ipmessaging/protocol/openid-connect/token
ACL_OPTIN_URL=https://optin.aclwhatsapp.com/api/v1/optin/bulk
ACL_SEND_URL=https://api.aclwhatsapp.com/pull-platform-receiver/v2/wa/messages
ACL_CLIENT_ID=
ACL_USERNAME=
ACL_PASSWORD=

# Must be a key in whatsapp_templates.yaml
TEMPLATE_NAME=linkforentrypassaccess
TEMPLATE_LANGUAGE=en

# --- Bunny storage -----------------------------------------------------------
# Hostname only (no https://, no zone). Region hosts look like sg.storage.bunnycdn.com
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_ZONE=
# Storage zone password (read-write), from Storage -> zone -> FTP & API Access
BUNNY_ACCESS_KEY=
# Public pull zone URL that serves the storage zone
BUNNY_CDN_URL=
# Folders inside the zone. QA: qa_entry / qa_exit. Production: entry / exit
BUNNY_ENTRY_FOLDER=entry
BUNNY_EXIT_FOLDER=exit

# Master switch. false = the worker runs and stays healthy but processes no jobs;
# new jobs wait as PENDING and are sent once this is set to true (then restart).
WHATSAPP_SEND_ENABLED=false

# --- Worker ------------------------------------------------------------------
POLL_INTERVAL_SECONDS=5
MAX_ATTEMPTS=5
# Delay before retry 1, 2, 3...; the last value repeats if attempts run longer
RETRY_BACKOFF_MINUTES=1,5,15,60
STUCK_JOB_MINUTES=10
DEFAULT_COUNTRY_CODE=91
HTTP_TIMEOUT_SECONDS=20
# Exit (so Docker restarts the container) after this many failed cycles in a row
MAX_CONSECUTIVE_DB_FAILURES=10
# Optional: also keep a local copy of every generated PDF here. Empty = off
PDF_OUTPUT_DIR=
LOG_LEVEL=INFO
# pretty = readable blocks, IST times (default) | line = one key=value line, UTC (for grep)
LOG_FORMAT=pretty
